&CONTROL
    calculation = 'nscf'
    verbosity = 'high'
    prefix = 'CrI3_scf_soc'
    pseudo_dir = './pseudo/'
    outdir = './temp_a1h_scf_clean/'
    disk_io = 'low'
/
&SYSTEM
    ibrav = 0
    nat = 16
    ntyp = 3
    ecutwfc = 50.0
    ecutrho = 600.0
    nbnd = 200
    occupations = 'smearing'
    smearing = 'mv'
    degauss = 0.005
    nosym = .true.
    noinv = .true.
    lspinorb = .true.
    noncolin = .true.
    starting_magnetization(1) = 0.5
    angle1(1) = 0.0
    angle2(1) = 0.0
    starting_magnetization(2) = 0.5
    angle1(2) = 180.0
    angle2(2) = 0.0
    starting_magnetization(3) = 0.0
    vdw_corr = 'dft-d3'
/
&ELECTRONS
    conv_thr = 1.0d-10
    mixing_beta = 0.03
    mixing_mode = 'plain'
    diagonalization = 'david'
/
