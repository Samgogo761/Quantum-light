&crystal
  a1_ang = 6.998304941, -0.001225784, 0.000
  a2_ang = -3.500214030, 6.062548544, 0.000
  a3_ang = 0.000, 0.000, 25.000
  E_fermi_eV = 0.0843
  SOC = 1
  wannier_tb_file = "TB_PLACEHOLDER"
  wannier_hr_file = ""
  wannier_r_file  = ""
/

&kgrid
  nkx = NK_PLACEHOLDER
  nky = NK_PLACEHOLDER
/

&bands
  nv_orig = 84
  nb_start = 1
  nb_end = 112
/

&laser
  wvl_nm = 3200.0
  intensity_Wcm2 = 2.0e11
  theta_deg = 0.0
  phi_cep_deg = 90.0
  ncyc = 4.0
  env_type = 2
  ellipticity = 0.0
  delta_phase_deg = 90.0
/

&timestep
  dt = 0.35
  n_dt_deph = 5
/

&dephasing
  T2_cycles = 0.5
  dephasing_enabled = .true.
/

&bsv
  bsv_enabled = .true.
  bsv_mean_intensity = 1.0e11
  bsv_seed = 42
  bsv_state_type = 'squeezed_vacuum'
  bsv_squeeze_r = R_PLACEHOLDER
  bsv_squeeze_theta_deg = TH_PLACEHOLDER
  bsv_sampling_mode = 'from_file'
  bsv_nodes_file = 'NODES_PLACEHOLDER'
  bsv_write_nodes = .false.
  bsv_save_ics_cs = .true.
  bsv_save_complex = .true.
  bsv_save_all_complex = .false.
  bsv_save_jt = .true.
  bsv_harmonics = '2,5,7,9,10'
  bsv_propagate_ids = 'PROPAGATE_IDS_PLACEHOLDER'
/

&method
  gauge_method = 'lg_cov'
/

&output
  save_geometry = .false.
  save_occupation = .true.
  occ_band_resolved = .true.
  occ_stride = OCC_STRIDE_PLACEHOLDER
/
