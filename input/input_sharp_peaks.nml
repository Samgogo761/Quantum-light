! Sharp-peak HHG configuration.
! Peak width is set by max(1/ncyc grid, dephasing FWHM ~ 1/(pi*T2_cycles)).
! Here: ncyc=16 -> 0.0625-order grid; T2_cycles=2 -> ~0.16-order FWHM => sharp,
! well-separated harmonic peaks with visible noise floor on a log plot.
! (Contrast: T2_cycles=0.1 gives ~3.2-order FWHM -> peaks wash into a continuum.)
&crystal
  a1_ang = 6.998304941, -0.001225784, 0.000
  a2_ang = -3.500214030, 6.062548544, 0.000
  a3_ang = 0.000, 0.000, 25.000
  E_fermi_eV = 0.0843
  SOC = 1
  wannier_tb_file = "../../../CrI3_tb.dat"
  wannier_hr_file = ""
  wannier_r_file  = ""
/

&kgrid
  nkx = 46
  nky = 46
/

&bands
  nv_orig = 84
  nb_start = 1
  nb_end = 112
/

&laser
  wvl_nm = 3200.0
  intensity_Wcm2 = 2.0e11
  theta_deg = 0.0
  phi_cep_deg = 90.0
  ncyc = 16.0
  env_type = 2
  ellipticity = 0.0
  delta_phase_deg = 90.0
/

&laser2
  wvl_nm_2 = 0.0
  intensity_Wcm2_2 = 0.0
/

&timestep
  dt = 0.35
  n_dt_deph = 5
/

&dephasing
  T2_cycles = 2.0
/

&bsv
  bsv_enabled = .false.
/

&method
  gauge_method = 'lg_cov'
/

&output
  save_geometry   = .true.
  save_occupation = .false.
/
