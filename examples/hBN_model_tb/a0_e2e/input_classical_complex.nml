&crystal
  a1_ang = 1.2500000000, -2.1650635095, 0.0000000000
  a2_ang = 1.2500000000,  2.1650635095, 0.0000000000
  a3_ang = 0.0000000000,  0.0000000000, 20.0000000000
  E_fermi_eV = 0.0
  SOC = 0
  wannier_tb_file = "../hBN_model_tb.dat"
  wannier_hr_file = ""
  wannier_r_file  = ""
/

&kgrid
  nkx = 20
  nky = 20
/

&bands
  nv_orig = 1
  nb_start = 1
  nb_end = 2
/

&laser
  wvl_nm = 1600.0
  intensity_Wcm2 = 3.5e12
  theta_deg = 0.0
  phi_cep_deg = 90.0
  ncyc = 6.0
  env_type = 2
  ellipticity = 0.0
  delta_phase_deg = 90.0
/

&timestep
  dt = 0.50
  n_dt_deph = 5
/

&dephasing
  T2_cycles = -1.0
  T2_fs = 5.0
/

&bsv
  bsv_enabled = .false.
/

&method
  gauge_method = 'lg_cov'
/

&output
  save_geometry = .false.
  save_occupation = .false.
  save_complex_hhg = .true.
/
