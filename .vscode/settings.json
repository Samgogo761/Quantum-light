{
  "editor.largeFileOptimizations": true,
  "files.followSymlinks": false,
  "search.followSymlinks": false,
  "git.autoRepositoryDetection": false,
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.detectSubmodules": false,
  "git.repositoryScanMaxDepth": 0,
  "git.untrackedChanges": "hidden",
  "scm.autoReveal": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv*/**": true,
    "**/.venv_q8_cuda/**": true,
    "**/site-packages/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.tmp*/**": true,
    "**/tmp/**": true,
    "**/.codex*/**": true,
    "**/.chart-data-*/**": true,
    "**/.workbuddy/**": true,
    "**/%SystemDrive%/**": true,
    "**/results/**": true,
    "**/HHG/**": true,
    "**/Jt/**": true,
    "**/output_*/**": true,
    "**/*.npz": true,
    "**/*.npy": true,
    "**/*.pptx": true,
    "**/*.pdf": true,
    "**/*.dat": true,
    "**/local_data/**": true,
    "**/local_runs/**": true
  },
  "search.exclude": {
    "**/.venv*/**": true,
    "**/.venv_q8_cuda/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.codex*/**": true,
    "**/.tmp*/**": true,
    "**/tmp/**": true,
    "**/.chart-data-*/**": true,
    "**/%SystemDrive%/**": true,
    "**/results/**": true,
    "**/*.npz": true,
    "**/*.npy": true,
    "**/*.pptx": true,
    "**/*.pdf": true,
    "**/local_data/**": true,
    "**/local_runs/**": true
  },
  "files.exclude": {
    "**/.venv_q8_cuda": true,
    "**/.venv*": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.tmp": true,
    "**/.tmp_ppt*": true,
    "**/tmp": true,
    "**/tmp_ppt_preview": true,
    "**/qa_preview_*": true,
    "**/.codex*": true,
    "**/.chart-data-*": true,
    "**/%SystemDrive%": true,
    "**/pelican-bike.html": true,
    "**/results": true,
    "**/HHG": true,
    "**/Jt": true,
    "**/local_data": true,
    "**/local_runs": true,
    "**/output_*": true
  },
  "python.analysis.exclude": [
    "**/.venv_q8_cuda/**",
    "**/site-packages/**",
    "**/node_modules/**",
    "**/results/**",
    "**/__pycache__/**",
    "**/.tmp*/**",
    "**/tmp/**",
    "**/local_data/**",
    "**/local_runs/**"
  ],
  "fortran.fortls.excludeDirs": [
    ".tmp",
    "tmp",
    "results",
    "docs",
    "tools",
    "local_data",
    "local_runs",
    ".venv_q8_cuda",
    "deploy",
    "examples"
  ]
}
